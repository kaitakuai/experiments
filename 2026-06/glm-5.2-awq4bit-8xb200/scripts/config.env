# config.env — GLM-5.2 AWQ-INT4 fraud, 8×B200 (sm_100), 2×TP=4 engines
# Pre-configured for the AWQ fraud PoC run.
# Full scripts live in ../glm-5.2-poc-backend-sweep/scripts/ — source this file to override defaults.

MODEL_ROLE="awq"
KV_CACHE_DTYPE="auto"               # compressed-tensors W4A16; fp8 KV not needed for fraud
GPU_MEM_UTIL="0.90"
MAX_MODEL_LEN="131072"
MAX_NUM_SEQS="128"
_DEFAULT_COMPILATION_CONFIG='{"mode": 0, "cudagraph_mode": "NONE"}'  # eager for PoC
COMPILATION_CONFIG="${COMPILATION_CONFIG:-$_DEFAULT_COMPILATION_CONFIG}"

# AWQ = compressed-tensors auto-detect; do NOT pass --quantization awq_marlin (causes ValidationError)
# TP=4 allows 2 engines per 8-GPU box → ~3072 nonces/min combined
# VLLM auto-detects compressed-tensors from model config; Marlin MoE kernel selected automatically

export VLLM_USE_DEEP_GEMM=0
export VLLM_MOE_USE_DEEP_GEMM=0
