# config.env — GLM-5.2 FP8, 8×H200 (sm_90)
# Pre-configured for the H200 reference run.
# Full scripts live in ../glm-5.2-poc-backend-sweep/scripts/ — source this file to override defaults.

MODEL_ROLE="fp8"
KV_CACHE_DTYPE="auto"               # bf16 KV for PoC (FLASHMLA_SPARSE rejects fp8_e4m3 on H200)
GPU_MEM_UTIL="0.90"                 # keep ~12.5 GB free/card for sparse_decode_fwd scratch
MAX_MODEL_LEN="450000"              # H200 practical ceiling with bf16 KV (gmu=0.90 ~553K cache, capped for serving headroom)
MAX_NUM_SEQS="128"
MAX_NUM_BATCHED_TOKENS="65536"      # lower from 131072; H200 OOMs on KV profiling at 131072 + bf16
_DEFAULT_COMPILATION_CONFIG='{"mode": 0, "cudagraph_mode": "NONE"}'  # eager = best PoC
COMPILATION_CONFIG="${COMPILATION_CONFIG:-$_DEFAULT_COMPILATION_CONFIG}"

# DeepGEMM disabled — same DSA linear kernel crash as B200
export VLLM_USE_DEEP_GEMM=0
export VLLM_MOE_USE_DEEP_GEMM=0
export VLLM_USE_FLASHINFER_MOE_FP8=0

# For max-context inference (450K tokens) run with:
# KV_CACHE_DTYPE=fp8_ds_mla GPU_MEM_UTIL=0.90 MAX_MODEL_LEN=450000
# fp8_ds_mla is the only fp8 KV format FLASHMLA_SPARSE accepts on Hopper (sm_90)
