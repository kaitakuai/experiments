# config.env — GLM-5.2 FP8, 8×B200 (sm_100)
# Pre-configured for the B200 reference run.
# Full scripts live in ../glm-5.2-poc-backend-sweep/scripts/ — source this file to override defaults.

MODEL_ROLE="fp8"
KV_CACHE_DTYPE="fp8_e4m3"          # sm_100 (Blackwell) native; fp8_ds_mla NOT needed on B200
GPU_MEM_UTIL="0.90"
MAX_MODEL_LEN="1048576"            # model maximum context (max_position_embeddings = 2^20); B200 (sm_100) supports the full window
MAX_NUM_SEQS="128"
_DEFAULT_COMPILATION_CONFIG='{"mode": 0, "cudagraph_mode": "NONE"}'  # eager = best PoC
COMPILATION_CONFIG="${COMPILATION_CONFIG:-$_DEFAULT_COMPILATION_CONFIG}"

# DeepGEMM disabled — crashes on GLM DSA linear kernel on B200 (cudaErrorInvalidValue)
# FlashInfer-CUTLASS disabled — shm_broadcast 60s hang on B200; auto (triton+cutlass) is the only working path
export VLLM_USE_DEEP_GEMM=0
export VLLM_MOE_USE_DEEP_GEMM=0
export VLLM_USE_FLASHINFER_MOE_FP8=0

# Override: for inference serving (not PoC), use cuda graphs:
# COMPILATION_CONFIG='{"mode": 3, "cudagraph_mode": "FULL_AND_PIECEWISE"}' bash ../glm-5.2-poc-backend-sweep/scripts/02_start_vllm.sh
